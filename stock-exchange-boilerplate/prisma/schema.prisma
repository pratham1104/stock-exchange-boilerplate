// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Side {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED // a MARKET order that found no liquidity at all — recorded for history, never rests
}

/**
 * Source of truth for orders. The API write-throughs every accept / fill / cancel here inside
 * one transaction with the matching result, then rebuilds the in-memory book from the OPEN /
 * PARTIALLY_FILLED rows on startup. `accountId` is the owning account (needed to rebuild the
 * cash/share reservation for a resting order after a restart).
 */
model Order {
  id             String      @id
  accountId      String
  symbol         String
  side           Side
  type           OrderType
  price          Float?
  quantity       Float
  filledQuantity Float       @default(0)
  status         OrderStatus @default(OPEN)
  timestamp      DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([symbol])
  @@index([status])
  @@index([accountId])
}

/**
 * One row per fill. buyOrderId/sellOrderId are plain columns with no foreign key — an order row
 * is written in the same transaction, but keeping these soft avoids ordering constraints and
 * makes trade history cheap to query on its own.
 */
model Trade {
  id        String   @id
  symbol    String
  price     Float
  quantity  Float
  timestamp DateTime
  createdAt DateTime @default(now())

  buyOrderId    String
  sellOrderId   String
  buyAccountId  String
  sellAccountId String

  @@index([symbol])
  @@index([buyOrderId])
  @@index([sellOrderId])
  @@index([buyAccountId])
  @@index([sellAccountId])
}

/**
 * Source of truth for accounts. `cashBalance` is settled (gross) cash — cash reserved against
 * open buy orders is NOT deducted here; the reservation is re-derived from the open Order rows
 * on startup. `apiKeyHash` is sha256 of the API key (the raw key is shown once at creation and
 * never stored). Written by the API inside the same transaction as the settlement that changed it.
 */
model Account {
  id          String     @id
  name        String
  apiKeyHash  String     @unique
  cashBalance Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  positions   Position[]
}

/** One row per (account, symbol) holding — total shares owned. Replaced wholesale on each account write. */
model Position {
  accountId String
  symbol    String
  quantity  Float
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, symbol])
  @@index([symbol])
}
