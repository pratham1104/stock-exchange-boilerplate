# Required
DATABASE_URL="postgresql://exchange:exchange@localhost:5432/exchange?schema=public"

# Optional (defaults shown)
PORT=4000
NODE_ENV=development
KAFKA_BROKER=localhost:9094
LOG_LEVEL=debug                    # trace|debug|info|warn|error|silent (default: info in production, debug otherwise)
ORDER_RATE_LIMIT_PER_MINUTE=120    # max order submissions per account per rolling minute
STARTUP_DB_TIMEOUT_MS=10000        # how long startup waits for Postgres before giving up
